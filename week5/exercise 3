#include <stdio.h>
#include <string.h>
enum Ex2 {
   MONDAY = 1,
   TUESDAY,
   WEDNESDAY,
   THURSDAY,
   FRIDAY,
   SATURDAY,
   SUNDAY
};

char* week(int word) {

    switch (word) {
        case MONDAY:
        return "Monday";
        case TUESDAY:
        return "Tuesday";
        case WEDNESDAY:
        return "Wednesday";
        case THURSDAY:
        return "Thursday";
        case FRIDAY:
        return "Friday";
        case SATURDAY:
        return "Saturday";
        case SUNDAY:
        return "Sunday";
        default:
        return "";
    }
}

int main() {
    int word;
    scanf("%d", &word);
    week(word);
    printf("%s", week(word));
}
