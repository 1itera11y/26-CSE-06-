#include <stdio.h>
int main() {
    int row;
    scanf("%d",&row);
    int num = 1;
    int spaces = row -1;
    for (int i = 1; i <= row; i++) {
        for (int j = 0; j < spaces; j++) {
            printf(" ");
        }
        for (int j = 0; j < i; j++) {
            printf("%d", num);
            num++;
        }
        spaces = row - i - 1;
        printf("\n");
    }
    return 0;
}
