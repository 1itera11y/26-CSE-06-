package com.example;
import java.util.Scanner;

public class Main {
   
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        System.out.println("Enter number of an integer array elements");
        float num = s.nextInt();
        float sum = 0;
        System.out.println("Enter elements of an array");
        for (int i = 0; i < num; i++) {
            int elem = s.nextInt();
            sum += elem;
        }
        System.out.printf("\nThe average value of your array: %.2f", sum/num);
    }
}
