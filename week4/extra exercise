#include <stdio.h>
#include <string.h>

struct recipe {
    char name[20];
    char ingredients[10][20];
};
void printcookbook(struct recipe *cookbook) {
    printf("name: %s\n", cookbook -> name);
    printf("ingredients:\n%s\n%s\n%s",cookbook -> ingredients[0], cookbook -> ingredients[1], cookbook -> ingredients[2], cookbook -> ingredients[3]);

}

int main() {
    struct recipe cookbook[2];
    strcpy(cookbook[0].name, "Omelette");
    strcpy(cookbook[0].ingredients[0], "Eggs");
    strcpy(cookbook[0].ingredients[1], "Milk");
    strcpy(cookbook[0].ingredients[2], "Oil");
    strcpy(cookbook[0].ingredients[3], "Salt");
    
    strcpy(cookbook[1].name, "Human");
    strcpy(cookbook[1].ingredients[0], "Knife");
    strcpy(cookbook[1].ingredients[1], "Axe");
    strcpy(cookbook[1].ingredients[2], "Salt");

    printf("Cookbook with 2 recipes:\n");
    for (int i = 0; i < 2; i++) {
        printf("\nrecipe %d:\n", i+1);
        printcookbook(&cookbook[i]);
        printf("\n");
    }

    return 0;
}
